---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const all = await getCollection('posts');
const isProd = !import.meta.env.DEV;
const koPosts = all
  .filter((p: CollectionEntry<'posts'>) => p.data.lang === 'ko')
  .filter((p: CollectionEntry<'posts'>) => !(isProd && p.data.draft))
  .sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  )
  .slice(0, 20);

const pairSlugsWithOtherLangs = new Set(
  all
    .filter((p: CollectionEntry<'posts'>) => p.data.lang !== 'ko')
    .map((p: CollectionEntry<'posts'>) => p.data.pairSlug)
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="tkim" lang="ko" activeLang={null}>
  <p>Tonghyun Kim의 기술 블로그 — 한국어, 일본어, 영어로 씁니다.</p>
  <hr />
  <section class="posts">
    <h3>최근 글</h3>
    <ul>
      {koPosts.map((p) => (
        <PostCard post={p} hasTranslation={pairSlugsWithOtherLangs.has(p.data.pairSlug)} />
      ))}
    </ul>
    <p class="all-posts-link">
      <a href={`${base}/ko/`}>전체 글 →</a>
    </p>
  </section>
</BaseLayout>
