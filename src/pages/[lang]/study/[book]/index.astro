---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  type Lang,
  bookOf,
  bookSlugFromId,
  chapterSlug,
  chaptersOfBook,
  getBookPairs,
} from '../../../../utils/studies';

export async function getStaticPaths() {
  const allBooks = await getCollection('books');
  const paths: Array<{ params: { lang: Lang; book: string } }> = [];
  for (const b of allBooks) {
    if (!import.meta.env.PROD || !b.data.draft) {
      paths.push({ params: { lang: b.data.lang, book: bookSlugFromId(b) } });
    }
  }
  return paths;
}

const { lang, book: bookSlug } = Astro.params as { lang: Lang; book: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allBooks = await getCollection('books');
const allChapters = await getCollection('studies');

const book = bookOf(allBooks, lang, bookSlug);
if (!book) {
  throw new Error(`Book not found: ${lang}/${bookSlug}`);
}

const chapters = chaptersOfBook(allChapters, lang, bookSlug, { includeDrafts: !import.meta.env.PROD });
const pairs = getBookPairs(allBooks, book);

const labels: Record<Lang, { toc: string; chapter: string; empty: string }> = {
  ko: { toc: '목차', chapter: '장', empty: '아직 작성된 장이 없습니다.' },
  ja: { toc: '目次', chapter: '章', empty: 'まだ章がありません。' },
  en: { toc: 'Table of contents', chapter: 'Chapter', empty: 'No chapters yet.' },
};
const L = labels[lang];

const langs: Array<'ko' | 'ja' | 'en'> = ['ko', 'ja', 'en'];

const alternates = langs
  .filter((l) => pairs[l])
  .map((l) => {
    const sib = pairs[l]!;
    const href = Astro.site
      ? new URL(`${base}/${l}/study/${bookSlugFromId(sib)}/`, Astro.site).toString()
      : `${base}/${l}/study/${bookSlugFromId(sib)}/`;
    return { lang: l, href };
  });
---

<BaseLayout
  title={`${book.data.bookTitle} — crowdy`}
  description={book.data.description}
  lang={lang}
  activeLang={lang}
  alternates={alternates}
>
  <p class="study-breadcrumb">
    <a href={`${base}/${lang}/study/`}>Study</a>
    {' › '}
    <span>{book.data.bookTitle}</span>
  </p>
  <h1>{book.data.bookTitle}</h1>
  {book.data.bookAuthor && <p class="book-author">{book.data.bookAuthor}</p>}
  <p>{book.data.description}</p>

  <nav class="lang-toggle" aria-label="Language">
    {langs.map((l) => {
      if (l === lang) {
        return <button aria-current="true">{l.toUpperCase()}</button>;
      }
      const sib = pairs[l];
      if (!sib) return null;
      return (
        <a href={`${base}/${l}/study/${bookSlugFromId(sib)}/`}>
          <button>{l.toUpperCase()}</button>
        </a>
      );
    })}
  </nav>

  <hr />
  <h2>{L.toc}</h2>
  {chapters.length === 0 ? (
    <p>{L.empty}</p>
  ) : (
    <ol class="chapter-toc">
      {chapters.map((c) => (
        <li>
          <a href={`${base}/${lang}/study/${bookSlug}/${chapterSlug(c)}/`}>
            <span class="chapter-num">{L.chapter} {c.data.chapter}</span>
            <span class="chapter-title">{c.data.title}</span>
          </a>
          {c.data.draft && <span class="chapter-draft"> · draft</span>}
        </li>
      ))}
    </ol>
  )}
</BaseLayout>
