---
import BaseLayout from './BaseLayout.astro';
import LangToggle from '../components/LangToggle.astro';
import { getCollection } from 'astro:content';
import { getPairs, postSlug } from '../utils/pairs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const all = await getCollection('posts');
const pairs = getPairs(all, post);
const dateStr = post.data.pubDate.toISOString().slice(0, 10);
const sourcePath = `src/content/posts/${post.id}`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const alternates = (['ko', 'ja', 'en'] as const)
  .filter((l) => pairs[l])
  .map((l) => {
    const sibling = pairs[l]!;
    const href = Astro.site
      ? new URL(`${base}/${sibling.data.lang}/${postSlug(sibling)}/`, Astro.site).toString()
      : `${base}/${sibling.data.lang}/${postSlug(sibling)}/`;
    return { lang: l, href };
  });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={post.data.lang}
  activeLang={post.data.lang}
  sourcePath={sourcePath}
  ogType="article"
  articlePublishedTime={post.data.pubDate.toISOString()}
  alternates={alternates}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time>
        {post.data.draft && <span> · draft</span>}
      </p>
      <LangToggle current={post} pairs={pairs} />
    </header>
    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>
